# ─── Required ───────────────────────────────────────────────────────────────

# OpenAI API Key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Upstash Redis REST — https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Your deployment base URL (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Optional ────────────────────────────────────────────────────────────────

# GitHub Personal Access Token for backlog export
# Needs: repo scope (Issues: read & write)
# Generate at: https://github.com/settings/tokens
# If not set, users will provide their own token via the UI
GITHUB_TOKEN=ghp_...
